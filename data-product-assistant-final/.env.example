# Copy to .env. Never commit .env.

# --- Azure Databricks ---
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main

# --- Models (Databricks Foundation Model APIs or Azure OpenAI) ---
DATABRICKS_LLM_MODEL=databricks-meta-llama-3-3-70b-instruct
# Optional: Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Unity Catalog: schemas are medallion layers ---
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_GOLD_SCHEMA=gold

# live | dry_run
DATABRICKS_PUBLISH_MODE=dry_run

# --- Storage (Unity Catalog Volumes) ---
UC_UPLOADS_VOLUME=/Volumes/main/default/uploads
UC_TEMPLATES_VOLUME=/Volumes/main/default/templates

# --- Packs ---
# Optional. Unset means packs load from the local packs/ directory.
PACKS_REGISTRY_URI=
