# Copy to .env. Never commit .env -- a predecessor product shipped live
# Anthropic, Azure and Databricks credentials beside its source.

# --- GCP ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Models ---
# Set these in exactly one place. SILVER declared three different model ids
# across .env, deploy.ps1 and code, and nobody knew which one ran.
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# --- BigQuery: datasets are medallion layers ---
BQ_DATASET_BRONZE=bronze
BQ_DATASET_SILVER=silver
BQ_DATASET_GOLD=gold

# live | dry_run -- must agree with whatever the deploy script sets
BQ_PUBLISH_MODE=dry_run

# --- State ---
FIRESTORE_DATABASE=(default)
SESSION_TTL_HOURS=24

# --- Storage ---
GCS_UPLOADS_BUCKET=
GCS_TEMPLATES_BUCKET=

# --- Packs ---
# Optional. Unset means packs load from the local packs/ directory.
PACKS_REGISTRY_URI=
