    },
    "cross_industry": {
      "supply_chain": {
        "path": "cross_industry/supply_chain.json",
        "display_name": "Supply Chain",
        "detection_signals": ["supplier", "warehouse", "shipment", "purchase order", "lead time", "otif", "procurement", "freight", "logistics", "epcis", "scor", "inbound", "outbound", "3pl"],
