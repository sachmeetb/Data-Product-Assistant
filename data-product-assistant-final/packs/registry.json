        "path": "retail/merchandise_planning.json",
        "display_name": "Merchandise Planning",
        "detection_signals": ["sku", "store", "inventory", "sell-through", "markdown", "pos", "shrinkage", "assortment", "planogram", "replenishment", "gtin", "merchandise", "stock", "on-hand"],
        "standards": ["GS1", "NRF_Retail", "ARTS_Retail"]
