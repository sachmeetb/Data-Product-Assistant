# Azure Databricks Workspace & SQL Warehouse
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main
DATABRICKS_BRONZE_SCHEMA=banking_bronze
DATABRICKS_SILVER_SCHEMA=banking_silver
DATABRICKS_GOLD_SCHEMA=banking_gold
DATABRICKS_PUBLISHER_MODE=auto

# LLM Endpoint (Databricks Foundation Model API / Model Serving)
DATABRICKS_LLM_MODEL=databricks-meta-llama-3-3-70b-instruct

# Optional: Azure OpenAI instead of Databricks Model Serving
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
