server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Handle POST requests to static SPA routes without 405
    error_page 405 =200 /index.html;

    # Proxy API calls to the configured backend / entrypoint
    location /__api/ {
        proxy_pass ${BACKEND_PROXY_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host ${BACKEND_PROXY_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache for hashed assets
    location ~* \.(js|css|png|jpg|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # No-cache for index.html so new deploys are picked up immediately
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
