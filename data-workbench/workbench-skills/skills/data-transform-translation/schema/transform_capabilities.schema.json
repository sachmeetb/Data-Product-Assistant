{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data-transform-translation/transform_capabilities",
  "title": "Generated transform capability runtime artifact",
  "description": "The single checksummed artifact the backend compiler + preflight read. Produced by data-transform-translation/scripts/build_artifact.py. Do not hand-edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checksum",
    "generated_at",
    "generator",
    "platforms",
    "portable_functions",
    "functions",
    "ops"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "sha256 over the canonical JSON of the artifact body with checksum+generated_at removed."
    },
    "generated_at": { "type": "string" },
    "generator": { "type": "string" },
    "source_skill": { "type": "string" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "portable_functions": {
      "type": "array",
      "description": "ANSI-safe function names supported (native) on EVERY served platform. Uppercase canonical.",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true
    },
    "functions": {
      "type": "object",
      "description": "Function name -> { description?, platforms: { platform -> capability entry } }.",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platforms"],
        "properties": {
          "description": { "type": "string" },
          "platforms": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/entry" }
          }
        }
      }
    },
    "ops": {
      "type": "object",
      "description": "Neutral op -> { description?, semantics: { variant -> { platform -> entry } } }.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantics"],
        "properties": {
          "description": { "type": "string" },
          "semantics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/entry" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "citation"],
      "properties": {
        "capability": { "type": "string", "enum": ["native", "emulated", "unsupported"] },
        "emit": { "type": "string" },
        "remediation": { "type": "string" },
        "engine": { "type": "string" },
        "status": { "type": "string", "enum": ["verified", "conformance-verify"] },
        "citation": { "type": "string", "minLength": 4 },
        "notes": { "type": "string" }
      }
    }
  }
}
