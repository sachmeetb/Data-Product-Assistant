    {
      "type": "text",
      "version": 1,
      "id": "351d06dbb72143e5977a",
      "x": 48.0,
      "y": 862.5,
      "width": 570.0,
      "height": 75.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1792501639,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "Discovery \u2192 Profiling \u2192 Enrichment \u2192 Products \u2192 Concepts\nLight Domain Ontology \u00b7 Explainability \u00b7 Traceability \u00b7 PROV-O provenance\nContext graph: understands all artifacts + interdependencies\nOntologies: SHACL \u00b7 PROV-O \u00b7 DCAT-2 \u00b7 W3C \u00b7 Custom product graph\nInput to Agent Skills (read) \u00b7 Output from Agent Skills (written)\nBrain of the Workbench \u2014 all artifacts and their relationships live here",
      "fontSize": 10,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Discovery \u2192 Profiling \u2192 Enrichment \u2192 Products \u2192 Concepts\nLight Domain Ontology \u00b7 Explainability \u00b7 Traceability \u00b7 PROV-O provenance\nContext graph: understands all artifacts + interdependencies\nOntologies: SHACL \u00b7 PROV-O \u00b7 DCAT-2 \u00b7 W3C \u00b7 Custom product graph\nInput to Agent Skills (read) \u00b7 Output from Agent Skills (written)\nBrain of the Workbench \u2014 all artifacts and their relationships live here",
      "autoResize": true,
      "lineHeight": 1.25
    },
