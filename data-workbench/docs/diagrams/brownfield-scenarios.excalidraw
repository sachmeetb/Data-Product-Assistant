    {
      "type": "text",
      "version": 1,
      "id": "49a3e370a17242429ccf",
      "x": 1196,
      "y": 980,
      "width": 241.79999999999998,
      "height": 211.25,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 1729079468,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "No 'request a source product to\nbe created' workflow today.\n\n\u2022 discovery-advisor surfaces\n  similar products + ODCS\n  templates, but can't kick off\n  a new dpe-sa run.\n\n\u2022 ProductRequestKind.\n  source_rediscovery exists,\n  but only for adding tables to\n  an ALREADY-DEPLOYED source \u2014\n  not for creating one.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No 'request a source product to\nbe created' workflow today.\n\n\u2022 discovery-advisor surfaces\n  similar products + ODCS\n  templates, but can't kick off\n  a new dpe-sa run.\n\n\u2022 ProductRequestKind.\n  source_rediscovery exists,\n  but only for adding tables to\n  an ALREADY-DEPLOYED source \u2014\n  not for creating one.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 1,
      "id": "ce0634b5513c47f29dc3",
      "x": 1196,
      "y": 1268,
      "width": 218.4,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#b91c1c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "seed": 689696766,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "\u26a0 GAP \u2014 needs new workflow",
      "fontSize": 14,
