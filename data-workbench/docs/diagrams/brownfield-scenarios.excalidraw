      "updated": 1,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "\u2022 MERGE :CONSUMES edges in\n  _save_odcs_to_graph\n\n\u2022 Engineer runs data_mapping\n  with --source-mode dprod\n\n\u2022 Mappings written as\n  :ColumnMapping \u2192\n  :DProdColumn",
