      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "isDeleted": false,
      "text": "One row per customer with:\n  \u2022 current segment\n  \u2022 lifetime spend\n  \u2022 order count\n  \u2022 return flag\n\nComposes:\n  customer table\n  + SCD-2 segment\n  + orders\n\n\u2192 Hits 3a if all three source\n  products exist.\n\u2192 Hits 3b if 'customer segment'\n  isn't registered yet.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One row per customer with:\n  \u2022 current segment\n  \u2022 lifetime spend\n  \u2022 order count\n  \u2022 return flag\n\nComposes:\n  customer table\n  + SCD-2 segment\n  + orders\n\n\u2192 Hits 3a if all three source\n  products exist.\n\u2192 Hits 3b if 'customer segment'\n  isn't registered yet.",
      "autoResize": true,
      "lineHeight": 1.25
    },
