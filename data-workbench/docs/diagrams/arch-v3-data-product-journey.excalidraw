    {
      "type": "text",
      "version": 1,
      "id": "645672a1652f47aa8f17",
      "x": 24.0,
      "y": 591.75,
      "width": 900.0,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
