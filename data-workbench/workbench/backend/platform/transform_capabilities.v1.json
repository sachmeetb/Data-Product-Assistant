            "remediation": "No native symbolic (yrs+mos+days) interval. Emit separate completed_units per unit, or a STRUCT of counts.",
            "citation": "https://cloud.google.com/bigquery/docs/reference/standard-sql/date_functions",
            "status": "verified",
            "engine": "BigQuery Standard SQL (GoogleSQL, current)"
          },
          "mysql": {
            "capability": "unsupported",
            "remediation": "No native symbolic (yrs+mos+days) interval. Emit separate completed_units per unit.",
            "citation": "https://dev.mysql.com/doc/refman/8.0/en/date-and-time-functions.html",
            "status": "verified",
            "engine": "MySQL 8.0+"
          }
