  "ops": {
    "date_difference": {
      "semantics": {
        "completed_units": {
          "postgres": {
            "capability": "native",
            "emit": "EXTRACT(YEAR FROM AGE({end}, {start}))",
            "notes": "AGE() yields a symbolic interval; EXTRACT(YEAR ...) reads completed whole years. Only YEAR shown; MONTH/DAY analogous.",
            "status": "conformance-verify",
            "citation": "https://www.postgresql.org/docs/current/functions-datetime.html",
            "engine": "PostgreSQL 12+"
          },
          "databricks": {
            "capability": "emulated",
            "emit": "FLOOR(MONTHS_BETWEEN({end}, {start}) / 12)",
            "notes": "Completed whole years. months_between is fractional; FLOOR after /12 yields completed years.",
            "status": "conformance-verify",
            "citation": "https://docs.databricks.com/en/sql/language-manual/functions/months_between.html",
            "engine": "Databricks Runtime 13+ / Apache Spark 3.4+ (Spark SQL)"
          },
          "snowflake": {
            "capability": "emulated",
            "emit": "FLOOR(MONTHS_BETWEEN({end}, {start}) / 12)",
            "notes": "Completed whole years.",
            "status": "conformance-verify",
            "citation": "https://docs.snowflake.com/en/sql-reference/functions/months_between",
            "engine": "Snowflake (current)"
          },
          "bigquery": {
            "capability": "emulated",
            "emit": "DATE_DIFF({end}, {start}, YEAR) - IF((EXTRACT(MONTH FROM {end}), EXTRACT(DAY FROM {end})) < (EXTRACT(MONTH FROM {start}), EXTRACT(DAY FROM {start})), 1, 0)",
            "notes": "DATE_DIFF YEAR counts boundaries; subtract 1 when the end's month/day is before the start's to get completed elapsed years.",
            "status": "conformance-verify",
            "citation": "https://cloud.google.com/bigquery/docs/reference/standard-sql/date_functions#date_diff",
            "engine": "BigQuery Standard SQL (GoogleSQL, current)"
          },
          "mysql": {
            "capability": "native",
            "emit": "TIMESTAMPDIFF(YEAR, {start}, {end})",
            "notes": "Completed whole years (elapsed).",
            "status": "conformance-verify",
            "citation": "https://dev.mysql.com/doc/refman/8.0/en/date-and-time-functions.html#function_timestampdiff",
            "engine": "MySQL 8.0+"
          }
        },
        "boundary_count": {
          "postgres": {
            "capability": "native",
            "emit": "EXTRACT(YEAR FROM {end}) - EXTRACT(YEAR FROM {start})",
            "notes": "Counts calendar-year boundaries crossed, NOT completed elapsed years.",
            "status": "conformance-verify",
            "citation": "https://www.postgresql.org/docs/current/functions-datetime.html",
            "engine": "PostgreSQL 12+"
          },
          "databricks": {
            "capability": "native",
            "emit": "YEAR({end}) - YEAR({start})",
            "notes": "Calendar-year boundaries crossed, NOT completed elapsed years.",
            "status": "conformance-verify",
            "citation": "https://docs.databricks.com/en/sql/language-manual/functions/year.html",
            "engine": "Databricks Runtime 13+ / Apache Spark 3.4+ (Spark SQL)"
          },
          "snowflake": {
            "capability": "native",
            "emit": "DATEDIFF('year', {start}, {end})",
            "notes": "Counts calendar-year boundaries, NOT completed elapsed years.",
            "status": "conformance-verify",
            "citation": "https://docs.snowflake.com/en/sql-reference/functions/datediff",
            "engine": "Snowflake (current)"
          },
          "bigquery": {
            "capability": "native",
            "emit": "DATE_DIFF({end}, {start}, YEAR)",
            "notes": "Counts calendar-year boundaries crossed.",
            "status": "conformance-verify",
            "citation": "https://cloud.google.com/bigquery/docs/reference/standard-sql/date_functions#date_diff",
            "engine": "BigQuery Standard SQL (GoogleSQL, current)"
          },
          "mysql": {
            "capability": "native",
            "emit": "YEAR({end}) - YEAR({start})",
            "notes": "Calendar-year boundaries crossed, NOT completed elapsed years.",
            "status": "conformance-verify",
            "citation": "https://dev.mysql.com/doc/refman/8.0/en/date-and-time-functions.html#function_year",
            "engine": "MySQL 8.0+"
          }
        },
        "symbolic_interval": {
          "postgres": {
            "capability": "native",
            "emit": "AGE({end}, {start})",
            "notes": "The composite years+months+days interval; only Postgres expresses this natively.",
            "status": "verified",
            "citation": "https://www.postgresql.org/docs/current/functions-datetime.html",
            "engine": "PostgreSQL 12+"
          },
          "databricks": {
            "capability": "unsupported",
            "remediation": "No native symbolic (yrs+mos+days) interval. Emit separate completed_units per unit, or a struct of counts.",
