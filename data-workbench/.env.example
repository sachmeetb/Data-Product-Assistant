# Data Workbench — local operator configuration.
#
#   cp .env.example .env      then fill in the values you need.
#
# `.env` is GITIGNORED and never committed; this template is the committed
# documentation of what belongs in it. `docker compose` reads `.env` for
# variable substitution, and only the vars explicitly forwarded on the
# `backend` service in docker-compose.yml reach the container — if you add a
# new setting here, forward it there too.
#
# `./dwb up` (compose mode) and `./dwb up --mode host` both read this file:
# compose via substitution, host mode by merging it into uvicorn's env.
# Every value is optional — the app boots without any of them (see the
# per-section notes for what stops working).


# ── LLM engine auth — pick ONE route ────────────────────────────────────────
# Without one of these the app still boots, but every stage that calls the
# model fails. `./dwb doctor` reports which route (if any) is configured.

# Route 1 — Azure AI Foundry. BOTH vars are required together.
# RESOURCE has NO default: it names your own private Azure resource, so there
# is deliberately nothing to fall back on. Setting the key without the resource
# is a HARD `./dwb doctor` failure and blocks `./dwb up`.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# The model *deployment* name on that resource. Optional — defaults to
# claude-opus-4-8. All four model tiers (main/opus/sonnet/haiku) are pinned to
# this one name, because a Foundry resource only serves deployments that exist
# on it; an un-deployed tier 404s with DeploymentNotFound.
ANTHROPIC_FOUNDRY_MODEL=

# Route 2 — direct Anthropic API. Used when no Foundry key is set; the Claude
# Agent SDK picks it up from the process env with no extra configuration.
# Foundry takes precedence when both keys are present.
ANTHROPIC_API_KEY=

# Route 3 — your workstation's own Claude Code subscription. If you already run
# Claude Code locally, mint a token instead of buying API credit:
#
#   claude setup-token          # interactive, opens a browser; prints the token
#
# Paste the result below. It is valid for ONE YEAR, so nothing has to refresh it.
# This is what makes the *container* stack work off a subscription: the backend's
# Agent SDK spawns the bundled Claude Code CLI, which reads this var from the
# process env — no ~/.claude is (or needs to be) mounted into the container.
#
# PERSONAL CREDENTIAL. It bills that one person's Claude subscription and carries
# their identity. Use it on your own laptop only — a shared or remote deployment
# must use Route 1 or Route 2 instead. Treat it like a password; `.env` is
# gitignored precisely so it never leaves the box.
#
# Precedence: ANTHROPIC_FOUNDRY_API_KEY > ANTHROPIC_API_KEY > CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_CODE_OAUTH_TOKEN=


# ── MCP control plane (/mcp + /po-mcp) ──────────────────────────────────────
# Bearer tokens, comma-separated. Formats:
#   token | token:principal | token:principal:proj1|proj2 | token:principal:projects:role
# ("projects" may be "*" for all; role ∈ owner|engineer|viewer).
# REQUIRED for any shared/remote deployment — with none set the MCP tools fail
# CLOSED and refuse every request.
WB_MCP_TOKENS=
# Local dev only: run /mcp open with no token. NEVER set on a shared box.
WB_MCP_ALLOW_INSECURE=

# ── Inbound intake (/api/intake/submit) ─────────────────────────────────────
# Scoped machine credentials for the external assessment tool. Format:
# "token:source_system" (comma-separated for several). The source_system is
# DERIVED from the token, never trusted from the request body.
WB_INTAKE_TOKENS=
# Local dev only: seed a single "dev-intake-token".
WB_INTAKE_ALLOW_INSECURE=


# ── Auth-off dev identity ───────────────────────────────────────────────────
# Used when request auth is DISABLED (no WB_AUTH_SECRET). MUST match the
# frontend's authStore.DEV_FALLBACK_EMAIL/NAME so the backend stamps the same
# owner/submitter the PO web view queries with — otherwise intake-scaffolded
# products never surface to the PO.
WB_DEV_USER_EMAIL=
WB_DEV_USER_NAME=


# ── Networking ──────────────────────────────────────────────────────────────
# Trusted PUBLIC origin of the BACKEND (e.g. http://backend.example:8000),
# baked into the served MCP kit installers + bootstrap prompt. Unset = fall
# back to the incoming request's Host (fine for local dev); set it on any
# shared/remote deploy so a forged Host header can't redirect installer fetches.
WB_PUBLIC_BASE_URL=


# ── Observability / OpenTelemetry (OPT-IN) ──────────────────────────────────
# DW emits telemetry ONLY when OTEL_EXPORTER_OTLP_ENDPOINT is set — unset means
# nothing is exported (no cost, no behaviour change). Point it at any OTLP
# backend (Honeycomb / Datadog / Grafana Cloud / a self-hosted collector), or
# run `./dwb up --with observability` to get the bundled reference collector
# wired up automatically. See docs/deployment-guide.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Defaults when the endpoint IS set: http/protobuf, otlp exporters for all
# three signals. Override any of them here.
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ATTRIBUTES=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_LOGS_EXPORTER=
CLAUDE_CODE_ENABLE_TELEMETRY=
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=
# Prompt/response CONTENT capture — OFF unless you explicitly opt in. Prompts
# embed Neo4j connection details. Passthrough only; DW never sets this itself.
OTEL_LOG_USER_PROMPTS=
