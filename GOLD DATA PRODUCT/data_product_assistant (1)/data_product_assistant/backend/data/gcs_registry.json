                "standards": ["SAP_TPM", "Salesforce_CPG", "Nielsen_TPM"]
            },
            "pricing": {
                "template_path": "cpg/pricing.json",
                "local_path": "pricing_silver_domain.json",
                "detection_signals": ["pricing", "price list", "margin", "competitor price", "price index", "price point", "price change", "srp", "edlp", "vendor price", "list price"],
                "standards": ["SAP_Pricing", "Vendavo", "Zilliant"]
