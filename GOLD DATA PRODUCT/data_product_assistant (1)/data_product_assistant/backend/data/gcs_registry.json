                "template_path": "banking/retail_banking.json",
                "local_path": "banking/retail_banking.json",
                "detection_signals": ["account", "transaction", "deposit", "withdrawal", "card", "loan", "mortgage", "kyc", "iban", "swift", "bic", "overdraft", "credit", "debit", "balance", "statement", "bank"],
