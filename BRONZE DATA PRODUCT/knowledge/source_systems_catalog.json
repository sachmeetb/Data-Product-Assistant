{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "catalog_name": "Bronze Source Systems & Banking Standards Catalog",
  "description": "Technical profiles, ingest characteristics, data standards, and sample schemas for Bronze layer landing.",
  "source_systems": {
    "hogan": {
      "name": "Hogan Deposit System",
      "system_type": "Mainframe Core Banking (Deposits & CIS)",
      "technology_stack": "IBM z/OS Mainframe, COBOL, VSAM / DB2",
      "default_encoding": "IBM EBCDIC (CP037) or ASCII Fixed-Width",
      "ingestion_pattern": "BATCH_FILE_COPYBOOK",
      "file_format": "FIXED_WIDTH",
      "record_delimiter": "\\n",
      "associated_standards": ["COBOL Copybooks", "BIAN Deposit Account v12", "Basel III LCR"],
      "default_retention_years": 7,
      "regulatory_frameworks": ["PRA", "FCA", "Basel III", "GDPR"],
      "primary_entities": [
        {
          "table_name": "brz_hogan_ci_customer",
          "feed_name": "CI-REC (Customer Information System Master)",
          "copybook": "CIBASIC.CPY",
          "record_length_bytes": 600,
          "ingestion_mode": "BATCH_COPYBOOK",
          "description": "Hogan CIS master customer demographic and tax classification records.",
          "sample_raw_columns": [
            {"name": "CI_CUST_NUM", "type": "STRING", "pic_clause": "PIC X(12)", "start_byte": 1, "length": 12, "is_pk": true, "description": "Unique CIS Customer Number"},
            {"name": "CI_CUST_TYPE", "type": "STRING", "pic_clause": "PIC X(2)", "start_byte": 13, "length": 2, "is_pk": false, "description": "Customer Entity Type (IND=Individual, COR=Corporate)"},
            {"name": "CI_LEGAL_NAME", "type": "STRING", "pic_clause": "PIC X(60)", "start_byte": 15, "length": 60, "is_pk": false, "is_pii": true, "description": "Full Legal Name"},
            {"name": "CI_TAX_ID", "type": "STRING", "pic_clause": "PIC X(15)", "start_byte": 75, "length": 15, "is_pk": false, "is_pii": true, "description": "National Tax Identifier (SSN / NIN / CRN)"},
            {"name": "CI_BIRTH_DT", "type": "STRING", "pic_clause": "PIC 9(8)", "start_byte": 90, "length": 8, "is_pk": false, "is_pii": true, "description": "Date of Birth (YYYYMMDD)"},
            {"name": "CI_PHONE", "type": "STRING", "pic_clause": "PIC X(15)", "start_byte": 98, "length": 15, "is_pk": false, "is_pii": true, "description": "Primary Telephone Number"},
            {"name": "CI_POST_CODE", "type": "STRING", "pic_clause": "PIC X(10)", "start_byte": 113, "length": 10, "is_pk": false, "is_pii": true, "description": "Residential Postcode / ZIP"},
            {"name": "CI_STATUS_CD", "type": "STRING", "pic_clause": "PIC X(2)", "start_byte": 123, "length": 2, "is_pk": false, "description": "CIS Relationship Status (01=Active, 05=Dormant)"},
            {"name": "CI_BRANCH_NUM", "type": "STRING", "pic_clause": "PIC 9(4)", "start_byte": 125, "length": 4, "is_pk": false, "description": "Home Branch Number"},
            {"name": "CI_EXTRACT_TS", "type": "STRING", "pic_clause": "PIC X(20)", "start_byte": 129, "length": 20, "is_pk": false, "description": "Mainframe Extract Timestamp"}
          ]
        },
        {
          "table_name": "brz_hogan_dd_account",
          "feed_name": "DD-REC (Demand Deposit Account Master)",
          "copybook": "DDBASIC.CPY",
          "record_length_bytes": 450,
          "ingestion_mode": "BATCH_COPYBOOK",
          "parent_key": "CI_CUST_NUM",
          "foreign_key": "DD_CUST_NUM",
          "description": "Hogan DDA master record containing deposit account statuses, ledgers, and balances (1:N per CIS Customer).",
          "sample_raw_columns": [
            {"name": "DD_ACCT_NUM", "type": "STRING", "pic_clause": "PIC X(10)", "start_byte": 1, "length": 10, "is_pk": true, "description": "Demand Deposit Account Number"},
            {"name": "DD_CUST_NUM", "type": "STRING", "pic_clause": "PIC X(12)", "start_byte": 11, "length": 12, "is_pk": false, "description": "CIS Customer Reference Number"},
            {"name": "DD_PROD_TYPE", "type": "STRING", "pic_clause": "PIC X(4)", "start_byte": 23, "length": 4, "is_pk": false, "description": "Deposit Product Code (e.g. CHKG, SAVG, MMDA)"},
            {"name": "DD_STATUS_CD", "type": "STRING", "pic_clause": "PIC X(2)", "start_byte": 27, "length": 2, "is_pk": false, "description": "Account Status Code (01=Active, 05=Dormant, 09=Closed)"},
            {"name": "DD_OPEN_DT", "type": "STRING", "pic_clause": "PIC 9(8)", "start_byte": 29, "length": 8, "is_pk": false, "description": "Account Opening Date (YYYYMMDD)"},
            {"name": "DD_CURR_BAL", "type": "NUMERIC", "pic_clause": "PIC S9(11)V99 COMP-3", "start_byte": 37, "length": 7, "is_pk": false, "description": "Current Ledger Balance"},
            {"name": "DD_AVAIL_BAL", "type": "NUMERIC", "pic_clause": "PIC S9(11)V99 COMP-3", "start_byte": 44, "length": 7, "is_pk": false, "description": "Available Balance"},
            {"name": "DD_BRANCH_NUM", "type": "STRING", "pic_clause": "PIC 9(4)", "start_byte": 51, "length": 4, "is_pk": false, "description": "Booking Branch Number"},
            {"name": "DD_CURRENCY", "type": "STRING", "pic_clause": "PIC X(3)", "start_byte": 55, "length": 3, "is_pk": false, "description": "ISO Currency Code"}
          ]
        },
        {
          "table_name": "brz_hogan_ci_address",
          "feed_name": "CI-ADDR (CIS Customer Address & Domicile Feed)",
          "copybook": "CIADDR.CPY",
          "record_length_bytes": 320,
          "ingestion_mode": "BATCH_COPYBOOK",
          "parent_key": "CI_CUST_NUM",
          "foreign_key": "CI_CUST_NUM",
          "description": "Hogan CIS multi-address feed capturing residential, mailing, and statement addresses per customer.",
          "sample_raw_columns": [
            {"name": "CI_ADDR_ID", "type": "STRING", "is_pk": true, "description": "CIS Address Record Sequence ID"},
            {"name": "CI_CUST_NUM", "type": "STRING", "is_pk": false, "description": "CIS Customer Reference Number"},
            {"name": "ADDR_USAGE_CD", "type": "STRING", "is_pk": false, "description": "Address Usage (RES=Residential, MAIL=Mailing, STMT=Statement)"},
            {"name": "STREET_LINE_1", "type": "STRING", "is_pk": false, "is_pii": true, "description": "Primary Street Address"},
            {"name": "CITY_NAME", "type": "STRING", "is_pk": false, "description": "City / Municipality"},
            {"name": "STATE_CD", "type": "STRING", "is_pk": false, "description": "US State / Province Code"},
            {"name": "POSTAL_CD", "type": "STRING", "is_pk": false, "is_pii": true, "description": "5-or-9 Digit Postal ZIP Code"},
            {"name": "COUNTRY_CD", "type": "STRING", "is_pk": false, "description": "ISO Country Code"},
            {"name": "VERIFIED_DT", "type": "STRING", "is_pk": false, "description": "KYC Address Verification Date (YYYYMMDD)"}
          ]
        }
      ]
    },
