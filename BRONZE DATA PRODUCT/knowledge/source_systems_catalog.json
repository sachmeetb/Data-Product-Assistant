            {"name": "WAERS", "type": "STRING", "is_pk": false, "description": "Transaction Currency Key"}
          ]
        },
        {
          "table_name": "brz_sap_bseg",
          "feed_name": "BSEG (Accounting Document Segment / Line Item)",
          "description": "SAP General Ledger line items with debit/credit indicators and cost allocations.",
          "sample_raw_columns": [
            {"name": "MANDT", "type": "STRING", "is_pk": true, "description": "SAP Client ID"},
            {"name": "BUKRS", "type": "STRING", "is_pk": true, "description": "Company Code"},
            {"name": "BELNR", "type": "STRING", "is_pk": true, "description": "Accounting Document Number"},
            {"name": "GJAHR", "type": "STRING", "is_pk": true, "description": "Fiscal Year"},
            {"name": "BUZEI", "type": "INT64", "is_pk": true, "description": "Line Item Number"},
