            {"name": "DMBTR", "type": "NUMERIC", "is_pk": false, "description": "Amount in Local Currency"},
            {"name": "WRBTR", "type": "NUMERIC", "is_pk": false, "description": "Amount in Document Currency"},
            {"name": "KOSTL", "type": "STRING", "is_pk": false, "description": "Cost Center ID"},
            {"name": "PRCTR", "type": "STRING", "is_pk": false, "description": "Profit Center ID"}
          ]
        }
      ]
    },
