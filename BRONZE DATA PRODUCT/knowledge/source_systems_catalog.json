{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "catalog_name": "Bronze Source Systems & Banking Standards Catalog",
  "description": "Technical profiles, ingest characteristics, data standards, and sample schemas for Bronze layer landing.",
  "source_systems": {
    "hogan": {
      "name": "Hogan Deposit System",
      "system_type": "Mainframe Core Banking (Deposits & CIS)",
      "technology_stack": "IBM z/OS Mainframe, COBOL, VSAM / DB2",
      "default_encoding": "IBM EBCDIC (CP037) or ASCII Fixed-Width",
      "ingestion_pattern": "BATCH_FILE_COPYBOOK",
      "file_format": "FIXED_WIDTH",
      "record_delimiter": "\\n",
      "associated_standards": ["COBOL Copybooks", "BIAN Deposit Account v12", "Basel III LCR"],
      "default_retention_years": 7,
      "regulatory_frameworks": ["PRA", "FCA", "Basel III", "GDPR"],
      "primary_entities": [
        {
          "table_name": "brz_hogan_dd_account",
          "feed_name": "DD-REC (Demand Deposit Account Master)",
          "copybook": "DDBASIC.CPY",
          "record_length_bytes": 450,
          "description": "Hogan DDA master record containing deposit account statuses, ledgers, and balances.",
          "sample_raw_columns": [
            {"name": "DD_ACCT_NUM", "type": "STRING", "pic_clause": "PIC X(10)", "start_byte": 1, "length": 10, "is_pk": true, "description": "Demand Deposit Account Number"},
            {"name": "DD_CUST_NUM", "type": "STRING", "pic_clause": "PIC X(12)", "start_byte": 11, "length": 12, "is_pk": false, "description": "CIS Customer Reference Number"},
            {"name": "DD_PROD_TYPE", "type": "STRING", "pic_clause": "PIC X(4)", "start_byte": 23, "length": 4, "is_pk": false, "description": "Deposit Product Code (e.g. CHKG, SAVG)"},
            {"name": "DD_STATUS_CD", "type": "STRING", "pic_clause": "PIC X(2)", "start_byte": 27, "length": 2, "is_pk": false, "description": "Account Status Code (01=Active, 05=Dormant, 09=Closed)"},
            {"name": "DD_OPEN_DT", "type": "STRING", "pic_clause": "PIC 9(8)", "start_byte": 29, "length": 8, "is_pk": false, "description": "Account Opening Date (YYYYMMDD)"},
            {"name": "DD_CURR_BAL", "type": "STRING", "pic_clause": "PIC S9(11)V99 COMP-3", "start_byte": 37, "length": 7, "is_pk": false, "description": "Current Ledger Balance in Minor Units"},
            {"name": "DD_AVAIL_BAL", "type": "STRING", "pic_clause": "PIC S9(11)V99 COMP-3", "start_byte": 44, "length": 7, "is_pk": false, "description": "Available Balance in Minor Units"},
            {"name": "DD_BRANCH_NUM", "type": "STRING", "pic_clause": "PIC 9(4)", "start_byte": 51, "length": 4, "is_pk": false, "description": "Booking Branch Number"},
            {"name": "DD_CURRENCY", "type": "STRING", "pic_clause": "PIC X(3)", "start_byte": 55, "length": 3, "is_pk": false, "description": "ISO Currency Code"}
          ]
        },
        {
          "table_name": "brz_hogan_ci_customer",
          "feed_name": "CI-REC (Customer Information System Master)",
          "copybook": "CIBASIC.CPY",
          "record_length_bytes": 600,
          "description": "Hogan CIS master customer demographic and tax classification records.",
          "sample_raw_columns": [
            {"name": "CI_CUST_NUM", "type": "STRING", "pic_clause": "PIC X(12)", "start_byte": 1, "length": 12, "is_pk": true, "description": "Unique CIS Customer Number"},
            {"name": "CI_CUST_TYPE", "type": "STRING", "pic_clause": "PIC X(2)", "start_byte": 13, "length": 2, "is_pk": false, "description": "Customer Entity Type (IND=Individual, COR=Corporate)"},
            {"name": "CI_LEGAL_NAME", "type": "STRING", "pic_clause": "PIC X(60)", "start_byte": 15, "length": 60, "is_pk": false, "is_pii": true, "description": "Full Legal Name"},
            {"name": "CI_TAX_ID", "type": "STRING", "pic_clause": "PIC X(15)", "start_byte": 75, "length": 15, "is_pk": false, "is_pii": true, "description": "National Tax Identifier (SSN / NIN / CRN)"},
            {"name": "CI_BIRTH_DT", "type": "STRING", "pic_clause": "PIC 9(8)", "start_byte": 90, "length": 8, "is_pk": false, "is_pii": true, "description": "Date of Birth (YYYYMMDD)"},
            {"name": "CI_POST_CODE", "type": "STRING", "pic_clause": "PIC X(10)", "start_byte": 98, "length": 10, "is_pk": false, "is_pii": true, "description": "Residential Postcode / ZIP"},
            {"name": "CI_RISK_RATING", "type": "STRING", "pic_clause": "PIC X(3)", "start_byte": 108, "length": 3, "is_pk": false, "description": "Internal AML/KYC Risk Rating"}
          ]
        }
      ]
    },
