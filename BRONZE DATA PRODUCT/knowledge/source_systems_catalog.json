            {"name": "BLDAT", "type": "STRING", "is_pk": false, "description": "Document Date (YYYYMMDD)"},
            {"name": "BUDAT", "type": "STRING", "is_pk": false, "description": "Posting Date in General Ledger (YYYYMMDD)"},
